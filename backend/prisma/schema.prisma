// Shadow — schéma de base de données
//
// Règle absolue respectée dans tout ce schéma :
// le serveur ne stocke JAMAIS de contenu en clair, ni de clé privée.
// Il ne stocke que ce qui est nécessaire à l'acheminement des messages
// chiffrés et à l'établissement des sessions cryptographiques (clés publiques).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ------------------------------------------------------------------
// UTILISATEURS
// ------------------------------------------------------------------

model User {
  id           String   @id @default(uuid())
  username     String   @unique
  displayName  String   @map("display_name")
  email        String?  @unique
  phone        String?  @unique
  avatarUrl    String?  @map("avatar_url")
  bio          String?
  passwordHash String   @map("password_hash") // argon2id, jamais le mot de passe en clair
  status       String?  // texte de statut libre, optionnel
  lastSeen     DateTime? @map("last_seen")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  // paramètres de confidentialité (section 36 du cahier des charges design)
  showLastSeen        Boolean @default(true) @map("show_last_seen")
  showOnlineStatus     Boolean @default(true) @map("show_online_status")
  showReadReceipts     Boolean @default(true) @map("show_read_receipts")
  showProfilePhoto     Boolean @default(true) @map("show_profile_photo")
  hideNotificationBody Boolean @default(false) @map("hide_notification_body")
  whoCanAddMe          String  @default("everyone") @map("who_can_add_me") // everyone | contacts_of_contacts | nobody

  devices              Device[]
  conversationMembers  ConversationMember[]
  sentMessages         Message[]              @relation("MessageSender")
  sessions             Session[]
  notifications        Notification[]
  blocksInitiated       Block[]                @relation("BlockBlocker")
  blocksReceived         Block[]                @relation("BlockBlocked")
  reportsFiled           Report[]               @relation("ReportReporter")
  reportsReceived        Report[]               @relation("ReportReported")
  securityEvents        SecurityEvent[]

  @@map("users")
}

// ------------------------------------------------------------------
// APPAREILS ET CLÉS (chaque appareil a ses propres clés — section 8/9)
// ------------------------------------------------------------------

model Device {
  id             String    @id @default(uuid())
  userId         String    @map("user_id")
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  deviceName     String    @map("device_name")
  deviceType     String    @map("device_type") // mobile | tablet | desktop
  platform       String?   // android | ios

  // Identity key publique de l'appareil (clé LONG TERME publique uniquement).
  // La clé privée correspondante ne quitte jamais l'appareil.
  identityPublicKey String  @map("identity_public_key")

  // Signed prekey publique (renouvelée périodiquement) + sa signature,
  // nécessaires à l'établissement de session façon X3DH.
  signedPreKeyPublic    String   @map("signed_prekey_public")
  signedPreKeySignature String   @map("signed_prekey_signature")
  signedPreKeyCreatedAt DateTime @map("signed_prekey_created_at")

  // Jeton de notification push Expo (expo-notifications) — optionnel, mis à
  // jour par l'appareil lui-même. Ne sert qu'à router une notification
  // générique ("Nouveau message"), jamais à transporter de contenu.
  pushToken      String?   @map("push_token")

  createdAt      DateTime  @default(now()) @map("created_at")
  lastActiveAt   DateTime  @default(now()) @map("last_active_at")
  revokedAt      DateTime? @map("revoked_at")

  oneTimePreKeys OneTimePreKey[]
  sentMessages   Message[]       @relation("MessageSenderDevice")
  sessions       Session[]

  @@index([userId])
  @@map("devices")
}

// Clés temporaires à usage unique (one-time prekeys), consommées à
// l'établissement d'une nouvelle session — jamais réutilisées.
model OneTimePreKey {
  id         String   @id @default(uuid())
  deviceId   String   @map("device_id")
  device     Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  publicKey  String   @map("public_key")
  keyId      Int      @map("key_id")
  usedAt     DateTime? @map("used_at")
  createdAt  DateTime @default(now()) @map("created_at")

  @@unique([deviceId, keyId])
  @@index([deviceId, usedAt])
  @@map("one_time_prekeys")
}

// ------------------------------------------------------------------
// CONVERSATIONS
// ------------------------------------------------------------------

model Conversation {
  id           String   @id @default(uuid())
  type         String   // direct | group
  name         String?  // uniquement pour les groupes
  avatarUrl    String?  @map("avatar_url")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  members      ConversationMember[]
  messages     Message[]

  @@map("conversations")
}

model ConversationMember {
  id             String       @id @default(uuid())
  conversationId String       @map("conversation_id")
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String       @map("user_id")
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  role           String       @default("member") // member | admin
  joinedAt       DateTime     @default(now()) @map("joined_at")
  leftAt         DateTime?    @map("left_at")
  mutedUntil     DateTime?    @map("muted_until")

  @@unique([conversationId, userId])
  @@index([userId])
  @@map("conversation_members")
}

// ------------------------------------------------------------------
// MESSAGES — jamais de texte en clair stocké (section 30 / PRINCIPE 2)
// ------------------------------------------------------------------

model Message {
  id               String       @id @default(uuid())
  conversationId   String       @map("conversation_id")
  conversation     Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  senderId         String       @map("sender_id")
  sender           User         @relation("MessageSender", fields: [senderId], references: [id])
  senderDeviceId   String       @map("sender_device_id")
  senderDevice     Device       @relation("MessageSenderDevice", fields: [senderDeviceId], references: [id])

  type             String       @default("text") // text | image | file | voice | system

  // Contenu opaque pour le serveur : jamais déchiffrable côté backend.
  encryptedPayload String       @map("encrypted_payload") // base64
  nonce            String       // IV/nonce du chiffrement authentifié
  encryptionVersion Int         @default(1) @map("encryption_version")

  // Bootstrap de session (X3DH) : clés PUBLIQUES uniquement, non secrètes,
  // présentes sur le premier message d'une nouvelle session pour permettre
  // au destinataire de dériver la même clé partagée.
  senderEphemeralPublicKey String? @map("sender_ephemeral_public_key")
  usedOneTimePreKeyId      Int?    @map("used_one_time_prekey_id")

  replyToId        String?      @map("reply_to_id")

  status           String       @default("sent") // sent | delivered | read
  deliveredAt      DateTime?    @map("delivered_at")
  readAt           DateTime?    @map("read_at")

  ephemeralSeconds Int?         @map("ephemeral_seconds")
  expiresAt        DateTime?    @map("expires_at")

  editedAt         DateTime?    @map("edited_at")
  deletedForAll    Boolean      @default(false) @map("deleted_for_all")
  deletedAt        DateTime?    @map("deleted_at")

  attachments      Attachment[]

  createdAt        DateTime     @default(now()) @map("created_at")

  @@index([conversationId, createdAt])
  @@index([expiresAt])
  @@map("messages")
}

// Pièces jointes chiffrées côté client avant upload (section 16/17/18)
model Attachment {
  id               String   @id @default(uuid())
  messageId        String   @map("message_id")
  message          Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)

  fileType         String   @map("file_type") // image | file | voice
  mimeType         String?  @map("mime_type")
  sizeBytes        Int      @map("size_bytes")
  storageUrl       String   @map("storage_url") // pointeur vers le blob chiffré
  encryptionNonce  String   @map("encryption_nonce")
  checksumSha256   String?  @map("checksum_sha256") // intégrité, calculé sur le blob chiffré

  createdAt        DateTime @default(now()) @map("created_at")

  @@map("attachments")
}

// ------------------------------------------------------------------
// SESSIONS / AUTHENTIFICATION
// ------------------------------------------------------------------

model Session {
  id               String    @id @default(uuid())
  userId           String    @map("user_id")
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceId         String    @map("device_id")
  device           Device    @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  refreshTokenHash String    @map("refresh_token_hash") // hash, jamais le token en clair
  userAgent        String?   @map("user_agent")
  ipAddressHash    String?   @map("ip_address_hash") // haché, pas l'IP en clair

  createdAt        DateTime  @default(now()) @map("created_at")
  expiresAt        DateTime  @map("expires_at")
  revokedAt        DateTime? @map("revoked_at")

  @@index([userId])
  @@index([deviceId])
  @@map("sessions")
}

// ------------------------------------------------------------------
// NOTIFICATIONS — jamais le contenu du message (section 37 / 19)
// ------------------------------------------------------------------

model Notification {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  type      String   // new_message | new_contact | device_revoked | security_alert
  // Jamais de champ "preview" avec le contenu du message ici, volontairement.
  metadata  Json?

  readAt    DateTime? @map("read_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId, readAt])
  @@map("notifications")
}

// ------------------------------------------------------------------
// BLOCAGES / SIGNALEMENTS
// ------------------------------------------------------------------

model Block {
  id          String   @id @default(uuid())
  blockerId   String   @map("blocker_id")
  blocker     User     @relation("BlockBlocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blockedId   String   @map("blocked_id")
  blocked     User     @relation("BlockBlocked", fields: [blockedId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now()) @map("created_at")

  @@unique([blockerId, blockedId])
  @@map("blocks")
}

model Report {
  id           String   @id @default(uuid())
  reporterId   String   @map("reporter_id")
  reporter     User     @relation("ReportReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  reportedId   String   @map("reported_id")
  reported     User     @relation("ReportReported", fields: [reportedId], references: [id], onDelete: Cascade)

  reason       String
  description  String?
  status       String   @default("open") // open | reviewing | closed

  createdAt    DateTime @default(now()) @map("created_at")

  @@map("reports")
}

// ------------------------------------------------------------------
// ÉVÉNEMENTS DE SÉCURITÉ (audit — section 5 / doc design)
// ------------------------------------------------------------------

model SecurityEvent {
  id        String   @id @default(uuid())
  userId    String?  @map("user_id")
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  type      String   // login_success | login_failed | device_added | device_revoked | key_rotated | password_changed | safety_number_changed
  metadata  Json?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId, type])
  @@map("security_events")
}
